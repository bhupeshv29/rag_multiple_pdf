# Google AI (Gemini) - used ONLY for answer generation.
# Embeddings are now fully local (transformers.js) and need no key.
GEMINI_API_KEY=your_google_ai_api_key

# Local embedding model (transformers.js, runs in-process, free/unlimited).
# Default: Xenova/all-MiniLM-L6-v2 (384-dim).
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# EMBEDDING_DIM=384

# Optional overrides (defaults shown)
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=case-intelligence
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Optional: paths for the dataset ingest script
# DOCS_DIR=/absolute/path/to/docs_for_test
# TRANSCRIPTS_DIR=/absolute/path/to/transcriptions_for_test
